  "components": {
    "schemas": {
      "Trick": {
        "type": "object",
        "required": ["trickName", "command"],
        "properties": {
          "trickName": {
            "type": "string",
            "readOnly": true,
            "description": "name of the trick",
            "example": "Sit"
          },
          "command": {
            "type": "string",
            "description": "Command to be used to make the pet perform the trick",
            "example": "Buddy Sit"
          }
        }
      }
    }
  }
}
